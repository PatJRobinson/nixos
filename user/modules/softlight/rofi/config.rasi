configuration {
    modi: "window,drun";
    icon-theme: "Numix-Circle";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    terminal: "ghostty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "Apps";
    sidebar-mode: true;
}
@theme "~/.config/rofi/softlight.rasi"
